generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Compromisso {
  id        Int      @id @default(autoincrement())
  titulo    String
  descricao String
  data      DateTime
  horario   String
  local     String
  status    String   @default("PENDENTE")
  criadoEm  DateTime @default(now())
}